{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "outDir": "./dist",
        "allowJs": true,
        "declaration": false,
        "sourceMap": false,
        "removeComments": true,
        "isolatedModules": true,
        "noEmit": false
    },
    "include": [
        "typescript/**/*",
        "scripts/**/*"
    ],
    "exclude": [
        "node_modules",
        "wwwroot",
        "aceBuild",
        "dist"
    ]
}
